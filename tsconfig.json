{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "next/link": ["./src/compat/link.tsx"],
      "next/image": ["./src/compat/image.tsx"],
      "next/navigation": ["./src/compat/navigation.ts"],
      "next/headers": ["./src/compat/server-only.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "app/page.tsx",
    "app/terms/page.tsx",
    "app/privacy/page.tsx",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "lib/auth/server.ts",
    "lib/supabase/server.ts"
  ]
}
